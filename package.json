{
	"name": "listula",
	"private": true,
	"version": "0.12.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "pnpm run icons && vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"gates": "bash scripts/gates.sh",
		"quick": "pnpm run gates && pnpm run check && pnpm run test:unit --run",
		"test:unit": "vitest",
		"test:e2e": "playwright test",
		"test": "pnpm run gates && pnpm run test:unit --run && pnpm run test:e2e",
		"icons": "node --experimental-strip-types scripts/icons.ts",
		"budget": "bash scripts/budget.sh"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.12.1",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.60.0",
		"@sveltejs/adapter-vercel": "^6.3.3",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@types/node": "^22",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"fast-check": "^4.9.0",
		"globals": "^17.6.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"sharp": "^0.35.3",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.0.16",
		"vitest": "^4.1.8"
	},
	"description": "A shared, end-to-end encrypted checklist.",
	"packageManager": "pnpm@10.33.0",
	"engines": {
		"node": ">=22"
	},
	"dependencies": {
		"@vercel/blob": "^2.7.0",
		"fractional-indexing": "^4.0.0"
	}
}
